<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Holds the YouTube session cookie; it must not leave the device through backups. -->
    <exclude
        domain="file"
        path="datastore" />
    <exclude
        domain="file"
        path="./exoplayer" />
    <exclude
        domain="file"
        path="./download" />
    <exclude
        domain="database"
        path="exoplayer_internal.db" />
</full-backup-content>